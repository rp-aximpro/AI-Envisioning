NODE_ENV=development
API_PORT=4000

APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_envision

SESSION_SECRET=change-me-in-development
OTP_SECRET=change-me-in-development
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
REQUESTER_SESSION_TTL_MINUTES=60
TRACKING_SESSION_TTL_MINUTES=480

SENDGRID_API_KEY=
EMAIL_FROM="AI Envisioning Workshops <no-reply@example.local>"

# Local proof-file storage is the default. Use a persistent mounted directory in staging/production.
FILE_STORAGE_DRIVER=local
LOCAL_FILE_STORAGE_DIR=uploads

# Optional for FILE_STORAGE_DRIVER=s3 and downloading legacy S3-backed proof files.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-envision-workshop-files
S3_FORCE_PATH_STYLE=true

PROGRAM_CURRENCY=EUR

MAX_UPLOAD_BYTES=10485760

ADMIN_BOOTSTRAP_EMAIL=admin@example.local
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_SESSION_IDLE_TTL_MINUTES=30
ADMIN_SESSION_ABSOLUTE_TTL_HOURS=12

LOG_LEVEL=info
